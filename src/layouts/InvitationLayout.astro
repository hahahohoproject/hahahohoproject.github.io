---
// 초대장 페이지 공통 레이아웃.
// 스타일은 아직 기존 템플릿 CSS(public/assets/css/main.css)를 그대로 쓴다.
interface Props {
  title: string;
  ogTitle?: string;
  description: string;
  /** 페이지 래퍼에 붙는 클래스. 기존 CSS가 배경 이미지를 이 클래스로 고른다. */
  wrapperClass: string;
}

const { title, ogTitle = title, description, wrapperClass } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/images/meta_thumb.jpg', Astro.site);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=yes" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:site_name" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <link rel="stylesheet" href="/assets/css/main.css" />
    <noscript><link rel="stylesheet" href="/assets/css/noscript.css" /></noscript>
  </head>
  <body class="landing is-preload">
    <div id="page-wrapper" class={wrapperClass}>
      <slot />
    </div>
    <script>
      import '../scripts/page';
    </script>
  </body>
</html>
