---
// 모든 페이지의 공통 뼈대: 메타 정보, 글꼴, 공통 스타일, 헤더와 푸터.
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource/gowun-batang/400.css';
import '@fontsource/gowun-batang/700.css';
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { cleanPath } from '../lib/paths';

interface Props {
  title: string;
  /** 공유 미리보기에 쓰는 제목. 없으면 title을 쓴다. */
  ogTitle?: string;
  description: string;
  /** 이 페이지의 강조색. 없으면 공통 스타일의 기본값을 쓴다. */
  accent?: string;
  /** 검색 엔진이 이 페이지를 수집하지 않게 한다. 404 페이지에 쓴다. */
  noindex?: boolean;
}

const { title, ogTitle = title, description, accent, noindex = false } = Astro.props;
const pageUrl = new URL(cleanPath(Astro.url.pathname), Astro.site);
const ogImage = new URL('/images/meta_thumb.jpg', Astro.site);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f3ec" />
    <!-- 페이지를 옮겨 다닐 때 부드럽게 넘어간다(지원하는 브라우저에서만). 바깥 스타일시트보다 먼저 읽히도록 여기에 둔다. -->
    <style is:inline>
      @view-transition {
        navigation: auto;
      }
    </style>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:site_name" content="HahaHoho Family" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <script is:inline>
      // 예전 링크(/wedding.html)로 들어와도 주소창에는 확장자 없는 주소를 보여 준다. 페이지를 다시 불러오지는 않는다.
      if (/\.html$/.test(location.pathname)) {
        var clean = location.pathname.replace(/(\/index)?\.html$/, '') || '/';
        history.replaceState(history.state, '', clean + location.search + location.hash);
      }
    </script>
  </head>
  <body style={accent ? `--accent: ${accent}` : undefined}>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  main {
    padding-top: var(--header-height);
  }

  .skip-link {
    position: fixed;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 200;
    padding: 0.6em 1em;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-size: var(--text-sm);
    text-decoration: none;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }
</style>
