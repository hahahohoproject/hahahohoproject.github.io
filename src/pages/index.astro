---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Hero from '../components/Hero.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import Section from '../components/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sortPhotos } from '../lib/photos';
import familyPhoto from '../assets/dowon/photos/4p.jpg';
import dowonCover from '../assets/dowon/photos/10p.jpg';
import weddingCover from '../assets/wedding/photos/photos02.jpg';

const weddingPhotos = sortPhotos(
  import.meta.glob<{ default: ImageMetadata }>('../assets/wedding/photos/*.jpg', { eager: true }),
);
const dowonPhotos = sortPhotos(
  import.meta.glob<{ default: ImageMetadata }>('../assets/dowon/photos/*.jpg', { eager: true }),
);

// 사진첩에 보여 줄 사진. 두 앨범에서 번갈아 고른다(숫자는 파일 이름 순서의 위치).
const pick = (photos: ImageMetadata[], ...positions: number[]) =>
  positions.map((position) => photos[position - 1]).filter((photo) => photo !== undefined);
const [w1, w5, w8, w10] = pick(weddingPhotos, 1, 5, 8, 10);
const [d2, d4, d5, d7, d8, d10] = pick(dowonPhotos, 2, 4, 5, 7, 8, 10);
const albumPhotos = [d4, w1, d5, w5, d7, w8, d8, w10, d2, d10].filter((photo) => photo !== undefined);

const family = [
  { role: '엄마', name: '심하은', latin: 'Ha eun' },
  { role: '아빠', name: '박호철', latin: 'Ho cheol' },
  { role: '아들', name: '박도원', latin: 'Dowon', note: '朴祹湲' },
];

const moments = [
  {
    href: '/wedding',
    date: '2022.01.22',
    title: '결혼식',
    latin: 'Wedding',
    summary: '하나님의 은혜 안에서 만난 두 사람이 믿음의 가정을 이루는 첫걸음을 내디뎠습니다.',
    action: '청첩장 보기',
    cover: weddingCover,
    alt: '흰 정장을 입은 하은과 호철',
  },
  {
    href: '/dowon',
    date: '2026.02.28',
    title: '도원이 첫 돌 예배',
    latin: "Dowon's 1st Birthday",
    summary: '하나님의 은혜 안에서 태어난 도원이의 첫 번째 생일을 함께 축하하고 기도했습니다.',
    action: '초대장 보기',
    cover: dowonCover,
    alt: '한복을 입고 의자에 앉은 도원이',
  },
];
---

<BaseLayout
  title="HahaHoho Family — 하하호호 가족"
  description="하은, 호철 그리고 도원. 하하호호 가족의 기록입니다."
>
  <Hero
    eyebrow="The HahaHoho Family"
    image={familyPhoto}
    imageAlt="눈을 감고 웃는 하은과 호철, 그 사이에 안긴 도원이"
    imagePosition="45% 35%"
    mobile="stack"
    cta={{ href: '#family', label: '가족 이야기' }}
  >
    Haha<br /><i>Hoho</i>
    <Fragment slot="meta">
      하은 · 호철 · 도원
      <span class="sub">웃음으로 채워 가는 우리 가족의 기록</span>
    </Fragment>
  </Hero>

  <Section id="family" eyebrow="우리 가족" title="Family.">
    <div class="family">
      <div class="origin reveal">
        <p class="equation">
          <span><i>Ha</i> eun</span>
          <span class="op">+</span>
          <span><i>Ho</i> cheol</span>
          <span class="op">=</span>
          <span>Haha<i>Hoho</i></span>
        </p>
        <p class="lede">
          하은의 ‘하’와 호철의 ‘호’를 모아 지은 이름입니다. 두 사람이 만나 가정을 이루었고, 도원이가 태어나 세 식구가
          되었습니다.
        </p>
      </div>
      <ul class="members reveal">
        {
          family.map((member) => (
            <li>
              <span class="role">{member.role}</span>
              <span class="name">{member.name}</span>
              <span class="latin">
                {member.latin}
                {member.note && <span class="note">{member.note}</span>}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section id="moments" eyebrow="함께한 순간" title="Moments." tone="sand">
    <ul class="moments">
      {
        moments.map((moment) => (
          <li class="reveal">
            <a class="moment" href={moment.href}>
              <div class="cover">
                <Image
                  src={moment.cover}
                  alt={moment.alt}
                  widths={[480, 800, 1200]}
                  sizes="(min-width: 48rem) 45vw, 92vw"
                />
              </div>
              <div class="caption">
                <p class="date">
                  <time datetime={moment.date.replaceAll('.', '-')}>{moment.date}</time>
                  <span>{moment.latin}</span>
                </p>
                <h3>{moment.title}</h3>
                <p class="summary">{moment.summary}</p>
                <span class="pill">
                  {moment.action}
                  <span aria-hidden="true">→</span>
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="album" eyebrow="사진첩" title="Album.">
    <PhotoGallery photoLabel="가족 사진" photos={albumPhotos} />
  </Section>

  <Section id="prayer" eyebrow="우리 가정의 기도" title="Pray for." tone="night" centered>
    <blockquote class="prayer reveal">
      <p>하나님이 주인되시며 주를 경외하는<br />지혜가 넘치는 가정이 되기를</p>
      <p>세상에 선한 행실로 빛을 비추고<br />하나님께 영광 돌리는 가정이 되기를</p>
    </blockquote>
  </Section>
</BaseLayout>

<style>
  /* 가족 소개 */
  .family {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .equation {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1em 0.35em;
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    line-height: 1.15;
  }

  .equation i {
    color: var(--accent);
  }

  .equation .op {
    color: var(--ink-soft);
    font-size: 0.6em;
  }

  .lede {
    max-width: 34rem;
    margin-top: 1.5rem;
    color: var(--ink-soft);
    font-size: var(--text-lg);
  }

  .members {
    border-top: 1px solid var(--line);
  }

  .members li {
    display: grid;
    grid-template-columns: 3.5rem 1fr auto;
    align-items: baseline;
    gap: 1rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .role {
    color: var(--ink-soft);
    font-size: var(--text-sm);
  }

  .name {
    font-family: var(--font-serif-ko);
    font-size: var(--text-xl);
  }

  .latin {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-style: italic;
    color: var(--accent);
    text-align: right;
  }

  .note {
    display: block;
    color: var(--ink-soft);
    font-family: var(--font-serif-ko);
    font-size: var(--text-sm);
    font-style: normal;
  }

  /* 함께한 순간 */
  .moments {
    display: grid;
    gap: clamp(2rem, 5vw, 3rem);
  }

  .moment {
    display: block;
    text-decoration: none;
  }

  .cover {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--line);
  }

  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .caption {
    padding-top: 1.5rem;
  }

  .date {
    display: flex;
    gap: 0.75em;
    color: var(--ink-soft);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }

  .date span {
    font-family: var(--font-serif);
    font-size: 1.15em;
    font-style: italic;
    letter-spacing: 0;
    color: var(--accent);
  }

  h3 {
    margin-top: 0.5rem;
    font-family: var(--font-serif-ko);
    font-size: var(--text-xl);
    line-height: 1.3;
  }

  .summary {
    max-width: 30rem;
    margin-top: 0.75rem;
    color: var(--ink-soft);
  }

  .moment .pill {
    margin-top: 1.25rem;
  }

  @media (hover: hover) {
    .moment:hover .cover :global(img) {
      transform: scale(1.04);
    }

    .moment:hover .pill {
      background: var(--ink);
      border-color: var(--ink);
      color: var(--paper);
    }
  }

  /* 기도 */
  .prayer {
    display: grid;
    gap: 1.75em;
    font-family: var(--font-serif-ko);
    font-size: var(--text-xl);
    line-height: 1.8;
    text-align: center;
  }

  @media (min-width: 48rem) {
    .moments {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 60rem) {
    .family {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      align-items: start;
    }
  }
</style>
