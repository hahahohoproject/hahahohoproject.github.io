---
// 페이지 첫 화면. 배치는 디자인이 정한다(<html data-hero>, src/config/themes.ts의 HeroLayout).
// 아래 기본 스타일이 split 배치이고, flush와 arch는 그 뒤에 덮어쓰는 규칙으로 정의한다.
// 기본 슬롯에 큰 제목을, meta 슬롯에 날짜·장소 같은 보조 정보를 넣는다.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  eyebrow: string;
  image: ImageMetadata;
  imageAlt: string;
  /** 사진이 잘릴 때 남길 위치. CSS object-position 값. */
  imagePosition?: string;
  cta?: { href: string; label: string };
  /**
   * split 배치일 때 휴대폰에서의 모양. overlay(기본)는 화면을 채운 사진 위에 글을 얹고,
   * stack은 사진을 4:5 카드로 보여 주고 글을 그 아래에 둔다. 가로 사진은 stack이 덜 잘린다.
   */
  mobile?: 'overlay' | 'stack';
}

const { eyebrow, image, imageAlt, imagePosition = 'center', cta, mobile = 'overlay' } = Astro.props;

const widths = [640, 960, 1440, 1920].filter((width) => width < image.width).concat(Math.min(image.width, 2400));
---

<section class:list={["hero", { stack: mobile === "stack" }]}>
  <div class="media">
    <Image
      src={image}
      alt={imageAlt}
      widths={widths}
      sizes="(min-width: 60rem) 50vw, 100vw"
      loading="eager"
      fetchpriority="high"
      style={`object-position: ${imagePosition}`}
    />
  </div>
  <div class="text">
    <p class="eyebrow">{eyebrow}</p>
    <h1><slot /></h1>
    <div class="meta"><slot name="meta" /></div>
    {
      cta && (
        <a class="pill" href={cta.href}>
          {cta.label}
          <span aria-hidden="true">↓</span>
        </a>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: calc(100svh - var(--header-height) - 0.75rem);
    margin-inline: 0.75rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    color: #fff;
  }

  .media {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--night);
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: hero-settle 1.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  /* 글자가 읽히도록 사진 아래쪽을 어둡게 한다 */
  .media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.74), rgb(0 0 0 / 0.2) 55%, rgb(0 0 0 / 0.08));
  }

  .text {
    align-self: end;
    padding: 2rem 1.5rem 2.25rem;
    animation: hero-rise 0.9s 0.15s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .eyebrow {
    color: inherit;
    opacity: 0.85;
  }

  h1 {
    margin-top: 0.875rem;
    font-size: var(--text-3xl);
    line-height: 0.95;
    letter-spacing: calc(var(--display-tracking) - 0.01em);
  }

  .meta {
    margin-top: 1.5rem;
    font-size: var(--text-lg);
    line-height: 1.6;
  }

  .meta :global(.sub) {
    display: block;
    opacity: 0.8;
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
  }

  .pill {
    margin-top: 1.75rem;
  }

  /* split 배치의 휴대폰용 stack 모양 */
  @media (max-width: 59.99rem) {
    :global([data-hero='split']) .hero.stack {
      display: block;
      min-height: 0;
      margin-inline: var(--gutter);
      padding-top: 0.25rem;
      border-radius: 0;
      overflow: visible;
      color: var(--ink);
    }

    :global([data-hero='split']) .stack .media {
      position: relative;
      inset: auto;
      z-index: 0;
      aspect-ratio: 4 / 5;
      border-radius: var(--radius-lg);
      overflow: hidden;
    }

    :global([data-hero='split']) .stack .media::after {
      display: none;
    }

    :global([data-hero='split']) .stack .text {
      padding: 1.75rem 0 0;
    }

    :global([data-hero='split']) .stack .eyebrow {
      color: var(--accent);
      opacity: 1;
    }

    :global([data-hero='split']) .stack h1 :global(i),
    :global([data-hero='split']) .stack h1 :global(em) {
      color: var(--accent);
    }
  }

  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--gutter);
      height: calc(100svh - var(--header-height));
      min-height: 36rem;
      margin-inline: 0;
      padding: 0.5rem var(--gutter) var(--gutter);
      border-radius: 0;
      overflow: visible;
      color: var(--ink);
    }

    .media {
      position: relative;
      inset: auto;
      z-index: 0;
      order: 2;
      border-radius: var(--radius-lg);
      overflow: hidden;
    }

    .media::after {
      display: none;
    }

    .text {
      padding: 0 0 1.5rem;
    }

    .eyebrow {
      color: var(--accent);
      opacity: 1;
    }

    h1 :global(i),
    h1 :global(em) {
      color: var(--accent);
    }
  }

  /* ── flush 배치: 사진이 화면 가장자리까지 붙고, 글은 사진 밖에 놓인다 ── */
  :global([data-hero='flush']) .hero {
    display: block;
    min-height: 0;
    margin-inline: 0;
    border-radius: 0;
    overflow: visible;
    color: var(--ink);
  }

  :global([data-hero='flush']) .media {
    position: relative;
    inset: auto;
    z-index: 0;
    aspect-ratio: 4 / 5;
    border-radius: 0;
    overflow: hidden;
  }

  :global([data-hero='flush']) .media::after {
    display: none;
  }

  :global([data-hero='flush']) .text {
    padding: 1.75rem var(--gutter) 0;
  }

  :global([data-hero='flush']) .eyebrow {
    color: var(--accent);
    opacity: 1;
  }

  :global([data-hero='flush']) h1 :global(i),
  :global([data-hero='flush']) h1 :global(em) {
    color: var(--accent);
  }

  @media (min-width: 60rem) {
    :global([data-hero='flush']) .hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 0;
      height: calc(100svh - var(--header-height));
      min-height: 36rem;
      padding: 0;
    }

    :global([data-hero='flush']) .media {
      order: 0;
      aspect-ratio: auto;
    }

    :global([data-hero='flush']) .text {
      align-self: center;
      padding: var(--gutter) clamp(2rem, 5vw, 5rem);
    }
  }

  /* ── arch 배치: 제목, 아치 모양 사진, 날짜가 한 줄로 가운데에 놓인다 ── */
  :global([data-hero='arch']) .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    gap: 0;
    height: auto;
    min-height: 0;
    margin-inline: 0;
    padding: clamp(2rem, 6vw, 4rem) var(--gutter) 0;
    border-radius: 0;
    overflow: visible;
    color: var(--ink);
    text-align: center;
  }

  /* 글 묶음을 풀어서 그 안의 제목과 날짜 사이에 사진이 끼어들 수 있게 한다 */
  :global([data-hero='arch']) .text {
    display: contents;
  }

  :global([data-hero='arch']) .eyebrow {
    order: 1;
    color: var(--accent);
    opacity: 1;
  }

  :global([data-hero='arch']) h1 {
    order: 2;
  }

  :global([data-hero='arch']) h1 :global(i),
  :global([data-hero='arch']) h1 :global(em) {
    color: var(--accent);
  }

  :global([data-hero='arch']) .media {
    order: 3;
    position: relative;
    inset: auto;
    z-index: 0;
    /* 사진 높이가 화면 높이의 절반 남짓을 넘지 않게 폭을 잡는다 */
    width: min(100%, 26rem, 44svh);
    aspect-ratio: 3 / 4;
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    border-radius: 999px 999px var(--radius) var(--radius);
    overflow: hidden;
  }

  :global([data-hero='arch']) .media::after {
    display: none;
  }

  :global([data-hero='arch']) .meta {
    order: 4;
  }

  :global([data-hero='arch']) .pill {
    order: 5;
  }

  @keyframes hero-settle {
    from {
      transform: scale(1.06);
    }

    to {
      transform: none;
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .media :global(img),
    .text {
      animation: none;
    }
  }
</style>
