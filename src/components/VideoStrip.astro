---
// 옆으로 넘겨 보는 영상 목록. 세로·가로 영상이 섞여 있어도 아랫선과 제목 줄을 맞춰 나란히 놓는다.
// 영상 파일은 재생을 누를 때 받기 시작한다.
export interface Video {
  title: string;
  src: string;
  poster: string;
  /** 영상의 가로÷세로 비율. 16:9면 16 / 9. */
  ratio: number;
}

interface Props {
  videos: Video[];
}

const { videos } = Astro.props;
---

<ul class="strip" tabindex="0" aria-label="영상 목록. 옆으로 넘겨 볼 수 있습니다">
  {
    videos.map((video) => (
      <li style={`--ratio: ${video.ratio.toFixed(4)}`}>
        <figure>
          <video controls playsinline preload="none" poster={video.poster} aria-label={video.title}>
            <source src={video.src} type="video/mp4" />
          </video>
          <figcaption>{video.title}</figcaption>
        </figure>
      </li>
    ))
  }
</ul>

<style>
  .strip {
    --height: clamp(15rem, 62vw, 26rem);
    display: flex;
    align-items: flex-end;
    gap: 1rem;
    /* 화면 끝까지 넘겨 볼 수 있게 컨테이너 여백 밖으로 내보낸다 */
    margin-inline: calc(var(--gutter) * -1);
    padding: 0 var(--gutter) 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, currentColor 35%, transparent) transparent;
  }

  li {
    flex: none;
    width: min(calc(var(--height) * var(--ratio)), 86vw);
    scroll-snap-align: start;
  }

  video {
    display: block;
    width: 100%;
    aspect-ratio: var(--ratio);
    border-radius: var(--radius);
    background: #000;
    object-fit: cover;
  }

  figcaption {
    margin-top: 0.875rem;
    overflow: hidden;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
